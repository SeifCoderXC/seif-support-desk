# Copy this file to .env. Do not commit .env.

DATABASE_URL=postgresql://console:console@db:5432/support_console?schema=public
JWT_SECRET=replace-this-before-sharing-the-port
SEED_AGENT_PASSWORD=support-local
PORT=3000

# Optional. The customer already answers from the case rules.
# A key only changes the wording, and only when that wording still matches the case.
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# CUSTOMER_AI=off
